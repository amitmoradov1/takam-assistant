# מפתח API של Anthropic — בלעדיו המערכת עובדת במצב "אחזור בלבד"
ANTHROPIC_API_KEY=

# אופציונלי: החלפת מודל (ברירת מחדל: claude-sonnet-5; לאיכות מרבית: claude-opus-5)
# TAKAM_MODEL=claude-sonnet-5

# אופציונלי: מספר הקטעים שנשלפים לכל שאלה (ברירת מחדל: 5)
# TAKAM_TOP_K=5

# אופציונלי: מגבלת בקשות לדקה לכל IP (ברירת מחדל: 30)
# TAKAM_RATE_LIMIT=30

# אופציונלי: רישום תוכן השאלות ללוג (ברירת מחדל: כבוי, מטעמי פרטיות)
# TAKAM_LOG_QUESTIONS=0

# אופציונלי: גודל cache התשובות (0 = כיבוי; ברירת מחדל: 256)
# TAKAM_CACHE_SIZE=256
